# Copia este archivo como `.env` y ajusta los valores del equipo donde corre el visor.

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=vetvisor
DB_USER=root
DB_PASSWORD=

# --- Seguridad ---
# Clave larga y aleatoria; cambia la cookie de sesión si se filtra.
SECRETO_SESION=cambia-esta-clave-por-una-larga-y-aleatoria
# Administrador que se crea solo la primera vez (si la tabla usuarios está vacía).
ADMIN_USUARIO=admin
ADMIN_PASSWORD=Vetvisor2026*

# --- Datos ---
# Carpeta con los XLSX que exporta Panther.
RUTA_EXPORTACION=.src
# Carpeta donde se guardarán los exámenes e imágenes que se suban.
RUTA_ALMACEN=storage/documentos

# --- QuFact (fase de facturación) ---
QUFACT_URL=http://127.0.0.1:8099
QUFACT_TOKEN=
